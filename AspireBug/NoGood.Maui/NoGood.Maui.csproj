<!--
  NoGood.Maui: A .NET MAUI Blazor Hybrid project whose name CONTAINS a period.
  This project is used in the AspireBug solution to demonstrate that a MAUI
  project with a period in its name causes failures with .NET Aspire.

  Aspire's source generator converts the project name to a C# identifier by
  replacing periods with underscores, producing: Projects.NoGood_Maui

  However, the RESOURCE NAME used at runtime is derived by replacing periods
  with hyphens and lowercasing, producing: "nogood-maui"

  The core bug: When Aspire processes the project reference for NoGood.Maui,
  the generated metadata type name (NoGood_Maui) and the expected resource
  endpoint name ("nogood-maui") are inconsistent. More critically, in some
  versions of the Aspire AppHost source generator, the period in the project
  name causes the generator to produce incorrect or missing IProjectMetadata
  implementations, resulting in a build-time or runtime error when
  builder.AddProject<Projects.NoGood_Maui>("nogood-maui") is invoked.

  AppHost usage: builder.AddProject<Projects.NoGood_Maui>("nogood-maui")  ✗ FAILS
-->
<Project Sdk="Microsoft.NET.Sdk.Razor">

  <PropertyGroup>
    <TargetFrameworks>net9.0-android;net9.0-ios;net9.0-maccatalyst</TargetFrameworks>
    <TargetFrameworks Condition="$([MSBuild]::IsOSPlatform('windows'))">$(TargetFrameworks);net9.0-windows10.0.19041.0</TargetFrameworks>
    <OutputType>Exe</OutputType>
    <RootNamespace>NoGood.Maui</RootNamespace>
    <AssemblyName>NoGood.Maui</AssemblyName>
    <UseMaui>true</UseMaui>
    <SingleProject>true</SingleProject>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <ApplicationTitle>NoGood.Maui</ApplicationTitle>
    <ApplicationId>com.companyname.nogood.maui</ApplicationId>
    <ApplicationDisplayVersion>1.0</ApplicationDisplayVersion>
    <ApplicationVersion>1</ApplicationVersion>
    <WindowsPackageType>None</WindowsPackageType>
    <SupportedOSPlatformVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'ios'">15.0</SupportedOSPlatformVersion>
    <SupportedOSPlatformVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'maccatalyst'">15.0</SupportedOSPlatformVersion>
    <SupportedOSPlatformVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'android'">24.0</SupportedOSPlatformVersion>
    <SupportedOSPlatformVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'windows'">10.0.17763.0</SupportedOSPlatformVersion>
    <TargetPlatformMinVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'windows'">10.0.17763.0</TargetPlatformMinVersion>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Maui.Controls" Version="9.0.60" />
    <PackageReference Include="Microsoft.AspNetCore.Components.WebView.Maui" Version="9.0.60" />
    <PackageReference Include="Microsoft.Extensions.Logging.Debug" Version="9.0.4" />
  </ItemGroup>

</Project>
